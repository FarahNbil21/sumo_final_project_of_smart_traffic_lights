<?xml version="1.0" encoding="UTF-8"?>

<!-- ملف تشغيل المحاكاة لـ SUMO -->
<configuration xmlns:xsi="http://www.w3.org" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de">

    <input>
        <net-file value="maadii.net.xml"/>
        <route-files value="demand/demand.rou.xml,microbus.rou.xml"/>
        <additional-files value="maadi_signals.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

</configuration>
